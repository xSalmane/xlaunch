# --- serveur
PUBLIC_URL=https://ton-domaine.xyz
PORT=8787
X_SITE=@tonCompte

# --- chaîne (base-sepolia pour tester, base en prod)
CHAIN=base-sepolia
RPC_URL=https://sepolia.base.org
FACTORY_ADDRESS=0x...

# Wallet qui paie le gas (garde peu d'ETH dessus, recharge-le régulièrement)
RELAYER_PRIVATE_KEY=0x...
# Clé qui autorise les réclamations — DIFFÉRENTE du relayer, idéalement dans un KMS
ATTESTER_PRIVATE_KEY=0x...
MIN_RELAYER_BALANCE_ETH=0.003
START_FDV_ETH=3

# --- déploiement (npm run deploy)
DEPLOYER_PRIVATE_KEY=0x...
TREASURY_ADDRESS=0x...
# part des frais de trading (1 %) reversée au créateur, en points de base (5000 = 50 %)
CREATOR_FEE_BPS=5000

# --- X OAuth 2.0 (developer.x.com > ton app > User authentication settings)
# Type : Web App (confidential client), callback : ${PUBLIC_URL}/auth/x/callback
X_CLIENT_ID=
X_CLIENT_SECRET=
JWT_SECRET=une-longue-chaine-aleatoire

# --- anti-spam
MIN_ACCOUNT_AGE_DAYS=30
MIN_FOLLOWERS=50
LAUNCHES_PER_USER_PER_DAY=1
GLOBAL_LAUNCHES_PER_HOUR=30
